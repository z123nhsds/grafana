{
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "generate": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    }
  },
  "tui": {
    "autoExit": true,
    "enabled": false
  },
  "defaultBase": "main",
  "nxCloud": false,
  "useDaemonProcess": true,
  "affected": {
    "defaultBase": "main"
  }
}
