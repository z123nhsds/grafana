{
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/yarn.lock",
      "{workspaceRoot}/.yarnrc.yml",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.yarn/plugins/**",
      "{workspaceRoot}/.yarn/patches/**",
      "{workspaceRoot}/.yarn/releases/**"
    ],
    "goWorkspaceGlobals": [
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum",
      "{workspaceRoot}/go.mod",
      "{workspaceRoot}/go.sum",
      "{workspaceRoot}/Makefile",
      "{workspaceRoot}/.golangci.yml",
      "{workspaceRoot}/.citools/**",
      "{workspaceRoot}/scripts/go-workspace/**"
    ],
    "lintGlobals": [
      "sharedGlobals",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/.prettierrc.js"
    ],
    "typecheckGlobals": [
      "sharedGlobals",
      "{workspaceRoot}/tsconfig.json"
    ],
    "testGlobals": [
      "sharedGlobals"
    ],
    "i18nGlobals": [
      "sharedGlobals",
      "{workspaceRoot}/i18next.config.ts",
      "{workspaceRoot}/public/locales/enterprise/i18next.config.ts"
    ],
    "knipGlobals": [
      "typecheckGlobals",
      "{workspaceRoot}/knip.config.ts",
      "{workspaceRoot}/i18next.config.ts",
      "{workspaceRoot}/public/locales/enterprise/i18next.config.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "inputs": ["default", "^default", "sharedGlobals"],
      "cache": true
    },
    "generate": {
      "cache": true
    },
    "lint": {
      "inputs": ["default", "^default", "lintGlobals"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^default", "typecheckGlobals"],
      "cache": true
    },
    "test:ci": {
      "inputs": ["default", "^default", "testGlobals"],
      "cache": true
    },
    "i18n-extract": {
      "inputs": ["default", "^default", "i18nGlobals"],
      "cache": true
    },
    "knip": {
      "inputs": ["default", "^default", "knipGlobals"],
      "cache": true
    },
    "lint-go": {
      "inputs": ["goWorkspaceGlobals", "{workspaceRoot}/pkg/**/*.go", "{workspaceRoot}/apps/**/*.go"],
      "cache": true
    },
    "test-go-unit": {
      "inputs": ["goWorkspaceGlobals", "{workspaceRoot}/pkg/**/*.go", "{workspaceRoot}/apps/**/*.go"],
      "cache": true
    }
  },
  "tui": {
    "autoExit": true,
    "enabled": false
  },
  "defaultBase": "main"
}
