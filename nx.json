{
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "generate": {
      "cache": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/jest.config.js",
        "{workspaceRoot}/jest.config.js",
        "{workspaceRoot}/tsconfig.json"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/**/*.tsx",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.json"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "eslint.config.js",
        ".eslintrc.js",
        "{workspaceRoot}/eslint.config.js"
      ]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "parallel": 8,
  "cacheDirectory": ".nx/cache",
  "tui": {
    "autoExit": true,
    "enabled": false
  },
  "defaultBase": "main"
}
