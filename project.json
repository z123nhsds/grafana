{
  "$schema": "https://json.schemastore.org/project.json",
  "name": "grafana",
  "tags": [],
  "implicitDependencies": [],
  "targets": {
    "lint-go": {
      "command": "make lint-go",
      "inputs": ["{workspaceRoot}/**/*.go", "!{workspaceRoot}/**/*_test.go"],
      "cache": true
    },
    "test-go-unit": {
      "command": "make test-go-unit",
      "inputs": ["{workspaceRoot}/**/*.go"],
      "cache": true
    },
    "build-go": {
      "command": "make build-go",
      "inputs": ["{workspaceRoot}/**/*.go", "{workspaceRoot}/go.work", "{workspaceRoot}/go.mod"],
      "outputs": ["{workspaceRoot}/bin/grafana"],
      "cache": true
    }
  }
}
